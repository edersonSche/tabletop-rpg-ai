# AI Provider: "opencode" or "openrouter" (required)
AI_PROVIDER=opencode

# API key for AI provider (required for openrouter, optional for opencode)
AI_API_KEY=

# AI model to use (required for both providers)
# OpenRouter format: "provider/model" (e.g., "openai/gpt-4o", "anthropic/claude-sonnet-4")
AI_MODEL=

# AI provider base URL
# OpenCode default: http://localhost:4096
# OpenRouter default: https://openrouter.ai/api/v1
AI_BASE_URL=http://localhost:4096

# CORS origin for frontend connection
CORS_ORIGIN=http://localhost:5173
